{
  "root": false,
  "$schema": "https://biomejs.dev/schemas/2.5.14/schema.json",
  "linter": {
    "enabled": true,
    "rules": {
      "preset": "recommended",
      "correctness": {},
      "suspicious": {},
      "complexity": {},
      "performance": {},
      "security": {},
      "style": { "noNonNullAssertion": "error" }
    }
  },
  "formatter": { "enabled": true, "indentStyle": "space", "indentWidth": 2 },
  "assist": { "actions": { "source": { "organizeImports": "on" } } }
}
