{
  "name": "@audit/worker",
  "version": "0.0.0",
  "private": true,
  "type": "module",
  "scripts": {
    "dev": "bun --watch src/index.ts",
    "start": "bun run src/index.ts",
    "build": "tsc --noEmit",
    "lint": "biome check .",
    "format": "biome format --write .",
    "typecheck": "tsc --noEmit",
    "test": "bun test --pass-with-no-tests"
  },
  "dependencies": {
    "@audit/db": "workspace:*",
    "@audit/domain": "workspace:*",
    "@audit/documents": "workspace:*",
    "@audit/lib": "workspace:*"
  },
  "devDependencies": {
    "@types/bun": "^1.4.2"
  }
}
