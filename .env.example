DATABASE_URL=postgres://audit:audit@localhost:5432/audit

# S3
S3_ENDPOINT=http://localhost:9000
S3_BUCKET=documents
S3_ACCESS_KEY=minio
S3_SECRET_KEY=minio123

# LLM (extraction + analysis)
# openai = paid API | deepseek | qwen = cheaper hosted APIs | heuristic = local regex/rules, no tokens
LLM_PROVIDER=openai
# openai:   gpt-5.6-sol | gpt-5.6-terra | gpt-5.6-luna | gpt-6-astra
# deepseek: deepseek-flash (text + vision) | deepseek-v4-pro (text)
# qwen:     qwen3.8-flash (text + vision) | qwen3.8-max (text) | qwen3-vl-plus (vision)
LLM_MODEL=gpt-5.6-terra

# OCR (Optical Character Recognition)
# openai    = vision model for classify + transcribe (handles rotation and handwriting)
# deepseek  = same, via DeepSeek's vision model (deepseek-flash)
# qwen      = same, via Qwen's vision model (qwen3.8-flash / qwen3-vl-plus)
# tesseract = hybrid: OpenAI vision model classifies; handwritten pages go to the vision model,
#             printed pages go to tesseract + orientation detection (needs OPENAI_API_KEY)
# local     = tesseract + orientation detection only, local classifier, no network
#             (no API keys; for tests, does not consume tokens)
OCR_PROVIDER=tesseract
# openai:   gpt-5.6-sol | gpt-5.6-terra | gpt-5.6-luna | gpt-6-astra
# deepseek: deepseek-flash
# qwen:     qwen3.8-flash | qwen3-vl-plus
OCR_MODEL=gpt-5.6-luna

# Required for the matching provider:
# OPENAI_API_KEY    -> LLM_PROVIDER=openai or OCR_PROVIDER=openai/tesseract
# DEEPSEEK_API_KEY  -> LLM_PROVIDER=deepseek or OCR_PROVIDER=deepseek
# DASHSCOPE_API_KEY -> LLM_PROVIDER=qwen or OCR_PROVIDER=qwen
# OPENCODE_API_KEY  -> LLM_PROVIDER=opencode or OCR_PROVIDER=opencode
OPENAI_API_KEY=sk-replace-me
DEEPSEEK_API_KEY=
DASHSCOPE_API_KEY=

# OpenCode Go subscription (https://opencode.ai/auth). OpenAI-compatible endpoint:
# https://opencode.ai/zen/go/v1. Intended primary provider; see README note.
OPENCODE_API_KEY=

# 32-byte key (base64 or 64-char hex) that encrypts API keys stored from /settings.
# Generate one with: openssl rand -base64 32
SETTINGS_ENCRYPTION_KEY=

DOCUMENT_RETENTION_DAYS=3000