DATABASE_URL=postgres://audit:audit@localhost:5432/audit

# S3
S3_ENDPOINT=http://localhost:9000
S3_BUCKET=documents
S3_ACCESS_KEY=minio
S3_SECRET_KEY=minio123

# LLM (extraction + analysis)
# openai = paid API | heuristic = local regex/rules, no tokens
LLM_PROVIDER=openai
# Supported: gpt-5.6-sol | gpt-5.6-terra | gpt-5.6-luna | gpt-6-astra
LLM_MODEL=gpt-5.6-terra

# OCR (Optical Character Recognition)
# openai    = vision model for classify + transcribe
# tesseract = tesseract binary for transcribe + vision model for classify (default; needs OPENAI_API_KEY)
# local     = tesseract binary for transcribe + local classifier, no network (no OPENAI_API_KEY)
OCR_PROVIDER=tesseract
# Supported: gpt-5.6-sol | gpt-5.6-terra | gpt-5.6-luna | gpt-6-astra
OCR_MODEL=gpt-5.6-luna

# Required when LLM_PROVIDER is openai or OCR_PROVIDER is openai/tesseract.
# Leave empty for local mode (LLM_PROVIDER=heuristic + OCR_PROVIDER=local).
OPENAI_API_KEY=sk-replace-me

DOCUMENT_RETENTION_DAYS=3000