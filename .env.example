DATABASE_URL=postgres://audit:audit@localhost:5432/audit

# S3
S3_ENDPOINT=http://localhost:9000
S3_BUCKET=documents
S3_ACCESS_KEY=minio
S3_SECRET_KEY=minio123

# LLM (extraction + analysis)
# openai = paid API | heuristic = local regex/rules, no tokens
LLM_PROVIDER=openai
LLM_MODEL=gpt-4.1

# OCR (Optical Character Recognition)
# openai    = vision model for classify + transcribe
# tesseract = tesseract binary for transcribe + vision model for classify (needs OPENAI_API_KEY)
# local     = tesseract binary for transcribe + local classifier, no network (no OPENAI_API_KEY)
OCR_PROVIDER=openai
OCR_MODEL=gpt-4.1

# Required when LLM_PROVIDER or OCR_PROVIDER is openai. Leave empty for local mode
# (LLM_PROVIDER=heuristic + OCR_PROVIDER=local).
OPENAI_API_KEY=sk-replace-me

DOCUMENT_RETENTION_DAYS=30